{
	"schemaVersion": 1,
	"id": "lyricraft",
	"version": "${version}",
	"name": "Lyricraft for Spotify",
	"description": "Live, synced karaoke lyrics for whatever you're playing on Spotify. No login, client-side only.",
	"authors": ["karfakias"],
	"contact": {
		"homepage": "https://modrinth.com/mod/lyricraft-for-spotify",
		"sources": "https://github.com/karfakias/lyricraft",
		"issues": "https://github.com/karfakias/lyricraft/issues"
	},
	"license": "MIT",
	"icon": "assets/lyricraft/icon.png",
	"environment": "client",
	"mixins": ["lyricraft.mixins.json"],
	"entrypoints": {
		"client": ["dev.lyricraft.LyricraftClient"],
		"modmenu": ["dev.lyricraft.gui.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
